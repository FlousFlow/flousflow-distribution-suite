<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Partner: GPS fields in the Distribution Information page -->
    <record id="view_partner_form_inherit_gps" model="ir.ui.view">
        <field name="name">res.partner.form.gps.location</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="flousflow_distribution_route_base.view_partner_form_inherit_distribution"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='distribution_info']" position="after">
                <group name="distribution_gps_location" string="GPS Location">
                    <group>
                        <field name="has_distribution_location" string="GPS Location Status"/>
                        <field name="distribution_latitude"/>
                        <field name="distribution_longitude"/>
                        <field name="distribution_location_accuracy"/>
                        <field name="location_url"
                               placeholder="Paste a Google Maps / WhatsApp location link..."
                               groups="flousflow_partner_location.group_location_manager"/>
                        <!-- Capture/extract actions are the widget buttons
                             below: they work BEFORE the record is saved, so
                             a new contact is never blocked by required-field
                             rules while the GPS flow is what fills the
                             address in the first place. -->
                        <!-- partner_* fields mirror distribution_* (sync).
                             Hidden via CSS (NOT invisible="1"): fields hidden
                             with invisible are dropped from the editable
                             record, which breaks the GPS widget's writes.
                             The class keeps them active but not displayed. -->
                        <field name="partner_latitude" class="o_hidden_location_helper"/>
                        <field name="partner_longitude" class="o_hidden_location_helper"/>
                        <field name="location_updated_at" class="o_hidden_location_helper"/>
                        <field name="location_updated_by" class="o_hidden_location_helper"/>
                        <field name="location_can_edit" invisible="1"/>
                    </group>
                    <group>
                        <field name="distribution_geofence_radius"/>
                        <field name="distribution_location_date" readonly="1"/>
                        <field name="distribution_location_user_id" readonly="1"/>
                        <field name="distribution_location_source" readonly="1"/>
                    </group>
                    <field name="location_panel" widget="partner_location_buttons"
                           nolabel="1" colspan="2"/>
                </group>
            </xpath>
            <!-- No type="object" GPS buttons in the button_box: they force a
                 save before running, which trips required-field rules on new
                 contacts. The widget buttons handle capture pre-save. -->
        </field>
    </record>

    <!-- Remove the standalone 'Customer Location' tab: its content is
         merged into the Distribution Information tab above, so users work
         in a single place instead of two overlapping location tabs. -->
    <record id="view_partner_form_remove_location_tab" model="ir.ui.view">
        <field name="name">res.partner.form.remove.duplicate.location.tab</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="flousflow_partner_location.view_partner_form_inherit_location"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='location']" position="replace"/>
        </field>
    </record>

</odoo>
