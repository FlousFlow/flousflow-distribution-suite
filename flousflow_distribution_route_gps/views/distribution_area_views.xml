<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Area: default geofence radius (Partner > Area > Global priority) -->
    <record id="view_distribution_area_form_gps" model="ir.ui.view">
        <field name="name">distribution.area.form.gps</field>
        <field name="model">distribution.area</field>
        <field name="inherit_id"
               ref="flousflow_distribution_route_base.view_distribution_area_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='management']" position="inside">
                <field name="default_geofence_radius"/>
            </xpath>
        </field>
    </record>

</odoo>
