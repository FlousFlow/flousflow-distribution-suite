<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View: Visit Results -->
    <record id="view_distribution_visit_result_list" model="ir.ui.view">
        <field name="name">distribution.visit.result.list</field>
        <field name="model">distribution.visit.result</field>
        <field name="arch" type="xml">
            <list string="Visit Results" sample="1">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="is_success"/>
                <field name="requires_notes"/>
                <field name="requires_revisit" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Form View: Visit Results -->
    <record id="view_distribution_visit_result_form" model="ir.ui.view">
        <field name="name">distribution.visit.result.form</field>
        <field name="model">distribution.visit.result</field>
        <field name="arch" type="xml">
            <form string="Visit Result">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Collected"/>
                        </h1>
                    </div>
                    <group>
                        <group name="general_info" string="General Information">
                            <field name="code" placeholder="e.g. collected"/>
                            <field name="sequence"/>
                            <field name="color" widget="color_picker"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group name="business_rules" string="Business Rules">
                            <field name="is_success"/>
                            <field name="requires_notes"/>
                            <field name="requires_revisit"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" nolabel="1" placeholder="When should this result be used..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View: Visit Results -->
    <record id="view_distribution_visit_result_search" model="ir.ui.view">
        <field name="name">distribution.visit.result.search</field>
        <field name="model">distribution.visit.result</field>
        <field name="arch" type="xml">
            <search string="Visit Results">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]" string="Name or Code"/>
                <filter string="Successful" name="filter_success" domain="[('is_success', '=', True)]"/>
                <filter string="Unsuccessful" name="filter_unsuccess" domain="[('is_success', '=', False)]"/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Success Flag" name="group_is_success" context="{'group_by': 'is_success'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action: Visit Results -->
    <record id="action_distribution_visit_result" model="ir.actions.act_window">
        <field name="name">Visit Results</field>
        <field name="res_model">distribution.visit.result</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first visit result
            </p>
            <p>
                Visit results record the business outcome of a visit
                (order taken, collected, customer closed...). Use flags
                instead of names to drive logic.
            </p>
        </field>
    </record>

</odoo>
