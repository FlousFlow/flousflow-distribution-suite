<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Partner: Distribution Visits smart button -->
    <record id="view_partner_form_inherit_route_visits" model="ir.ui.view">
        <field name="name">res.partner.form.route.visits</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="object"
                        name="action_view_distribution_visits"
                        icon="fa-map-signs"
                        groups="flousflow_distribution_route_base.group_distribution_route_user">
                    <field name="distribution_visit_count" widget="statinfo" string="Visits"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
