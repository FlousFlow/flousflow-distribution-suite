<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Privilege (Odoo 19 group category) -->
    <record model="res.groups.privilege" id="res_groups_privilege_distribution_route">
        <field name="name">Distribution Route</field>
        <field name="sequence">26</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <!-- Security Groups -->
    <record id="group_distribution_route_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_distribution_route"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="comment">Distribution representatives: read-only access to distribution master data.</field>
    </record>

    <record id="group_distribution_route_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_distribution_route"/>
        <field name="implied_ids" eval="[(4, ref('group_distribution_route_user'))]"/>
        <field name="comment">Distribution managers: full access to distribution master data and configuration.</field>
    </record>

    <!-- Multi-company record rules: Distribution Areas -->
    <record id="rule_distribution_area_company" model="ir.rule">
        <field name="name">Distribution Area: multi-company</field>
        <field name="model_id" ref="model_distribution_area"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Multi-company record rules: Visit Types -->
    <record id="rule_distribution_visit_type_company" model="ir.rule">
        <field name="name">Distribution Visit Type: multi-company</field>
        <field name="model_id" ref="model_distribution_visit_type"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
