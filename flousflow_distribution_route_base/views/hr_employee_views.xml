<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Employee Form: Distribution section -->
    <record id="view_hr_employee_form_inherit_distribution" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.distribution.route.base</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Distribution" name="distribution">
                    <group>
                        <group name="distribution_general" string="Distribution">
                            <field name="is_distribution_employee"/>
                            <field name="distribution_active" invisible="not is_distribution_employee"/>
                            <field name="distribution_supervisor_id" invisible="not is_distribution_employee"/>
                        </group>
                        <group name="distribution_areas" string="Distribution Areas" invisible="not is_distribution_employee">
                            <field name="distribution_area_ids" widget="many2many_tags" nolabel="1"
                                   placeholder="Areas in which this employee operates..."/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
