<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View: Distribution Areas -->
    <record id="view_distribution_area_list" model="ir.ui.view">
        <field name="name">distribution.area.list</field>
        <field name="model">distribution.area</field>
        <field name="arch" type="xml">
            <list string="Distribution Areas" sample="1">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="parent_id" optional="show"/>
                <field name="manager_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Form View: Distribution Areas -->
    <record id="view_distribution_area_form" model="ir.ui.view">
        <field name="name">distribution.area.form</field>
        <field name="model">distribution.area</field>
        <field name="arch" type="xml">
            <form string="Distribution Area">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Cairo"/>
                        </h1>
                    </div>
                    <group>
                        <group name="general_info" string="General Information">
                            <field name="code" placeholder="e.g. CAI-MDI"/>
                            <field name="parent_id"/>
                            <field name="sequence"/>
                            <field name="color" widget="color_picker"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group name="management" string="Management">
                            <field name="manager_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Employees" name="employees">
                            <group>
                                <field name="employee_ids" widget="many2many_tags" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Sub Areas" name="sub_areas">
                            <field name="child_ids">
                                <list string="Sub Areas" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="manager_id"/>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <group>
                                <field name="description" nolabel="1" placeholder="Internal description of this distribution area..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View: Distribution Areas -->
    <record id="view_distribution_area_search" model="ir.ui.view">
        <field name="name">distribution.area.search</field>
        <field name="model">distribution.area</field>
        <field name="arch" type="xml">
            <search string="Distribution Areas">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]" string="Name or Code"/>
                <field name="code"/>
                <field name="manager_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Top Level Areas" name="filter_top_level" domain="[('parent_id', '=', False)]"/>
                <filter string="My Company" name="filter_my_company" domain="[('company_id', 'in', allowed_company_ids)]" groups="base.group_multi_company"/>
                <group>
                    <filter string="Parent Area" name="group_by_parent" context="{'group_by': 'parent_id'}"/>
                    <filter string="Manager" name="group_by_manager" context="{'group_by': 'manager_id'}"/>
                    <filter string="Company" name="group_by_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_distribution_area" model="ir.actions.act_window">
        <field name="name">Distribution Areas</field>
        <field name="res_model">distribution.area</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_distribution_area_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first distribution area
            </p>
            <p>
                Organize areas hierarchically, e.g. Cairo → Maadi → Zahraa Maadi.
                Each area can have a manager, employees and sub-areas.
            </p>
        </field>
    </record>

</odoo>
