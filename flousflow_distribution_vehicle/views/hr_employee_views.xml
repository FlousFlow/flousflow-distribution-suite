<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Employee form: current vehicle + assignment history -->
    <record id="view_employee_form_inherit_distribution_vehicle" model="ir.ui.view">
        <field name="name">hr.employee.form.distribution.vehicle</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="before">
                <group string="Distribution" name="distribution_vehicle_info">
                    <field name="current_distribution_vehicle_id"/>
                </group>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Vehicle History" name="distribution_vehicle_history">
                    <field name="distribution_assignment_ids" readonly="1">
                        <list string="Vehicle Assignments">
                            <field name="vehicle_id"/>
                            <field name="role"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
