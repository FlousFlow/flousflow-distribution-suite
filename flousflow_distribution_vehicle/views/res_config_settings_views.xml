<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Settings: Vehicle operations -->
    <record id="res_config_settings_view_form_vehicle" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.distribution.vehicle</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id"
               ref="flousflow_distribution_route_base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='distribution_route_base']" position="inside">
                <block title="Vehicles" name="distribution_vehicle_setting_container">
                    <setting id="distribution_vehicle_negative_stock_setting"
                             string="Allow Vehicle Negative Stock"
                             help="Allow POS sales exceeding the vehicle warehouse quantity. Disabled by default">
                        <field name="distribution_allow_vehicle_negative_stock"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
