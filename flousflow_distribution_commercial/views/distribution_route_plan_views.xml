<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Route plan: commercial summary (spec #59) -->
    <record id="view_distribution_route_plan_form_inherit_commercial"
            model="ir.ui.view">
        <field name="name">distribution.route.plan.form.commercial</field>
        <field name="model">distribution.route.plan</field>
        <field name="inherit_id" ref="flousflow_distribution_route_management.view_distribution_route_plan_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='notes']" position="before">
                <page string="Commercial Summary" name="commercial_summary">
                    <group>
                        <group string="Sales">
                            <field name="quotation_count"/>
                            <field name="quotation_amount"/>
                            <field name="sale_order_count"/>
                            <field name="sale_order_amount"/>
                            <field name="pos_order_count"/>
                            <field name="pos_sales_amount"/>
                            <field name="company_currency_id" invisible="1"/>
                        </group>
                        <group string="Collections">
                            <field name="collection_count"/>
                            <field name="submitted_collection_amount"/>
                            <field name="validated_collection_amount"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
