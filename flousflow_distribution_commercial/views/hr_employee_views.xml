<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Employee: collections smart button (#61) -->
    <record id="view_employee_form_inherit_commercial" model="ir.ui.view">
        <field name="name">hr.employee.form.commercial</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_distribution_collections" type="object"
                        class="oe_stat_button" icon="fa-money"
                        invisible="distribution_collection_count == 0">
                    <field name="distribution_collection_count" widget="statinfo"
                           string="Collections"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
