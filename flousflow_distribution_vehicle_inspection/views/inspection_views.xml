<odoo>
 <record id="inspection_tree" model="ir.ui.view"><field name="name">vehicle.inspection.tree</field><field name="model">distribution.vehicle.inspection</field><field name="arch" type="xml"><list><field name="name"/><field name="inspection_type"/><field name="driver_id"/><field name="vehicle_id"/><field name="scheduled_date"/><field name="priority"/><field name="state"/><field name="result"/><field name="review_decision"/><field name="overdue"/></list></field></record>
 <record id="inspection_form" model="ir.ui.view"><field name="name">vehicle.inspection.form</field><field name="model">distribution.vehicle.inspection</field><field name="arch" type="xml"><form><header><button name="action_start" type="object" string="Start"/><button name="action_submit" type="object" string="Submit"/><button name="action_review" type="object" string="Review"/><button name="action_reject" type="object" string="Reject"/><button name="action_override" type="object" string="Manager Override"/><field name="state" widget="statusbar"/></header><sheet><group col="2"><group><field name="name"/><field name="inspection_type"/><field name="template_id"/><field name="driver_id"/><field name="vehicle_id"/></group><group><field name="scheduled_date"/><field name="priority"/><field name="route_plan_id"/><field name="result" readonly="1"/><field name="review_decision" readonly="1"/><field name="completed_by" readonly="1"/><field name="completed_at" readonly="1"/><field name="overdue" readonly="1"/><field name="instructions"/></group></group><field name="line_ids"><list editable="bottom"><field name="name" readonly="1"/><field name="response_value"/><field name="note"/><field name="attachment_ids" widget="many2many_binary"/></list></field></sheet></form></field></record>
 <record id="inspection_action" model="ir.actions.act_window"><field name="name">Vehicle Inspections</field><field name="res_model">distribution.vehicle.inspection</field><field name="view_mode">list,form</field></record>
 <record id="adhoc_inspection_action" model="ir.actions.act_window"><field name="name">Ad hoc Inspections</field><field name="res_model">distribution.vehicle.inspection</field><field name="view_mode">list,form</field><field name="domain">[('inspection_type','=','adhoc')]</field></record>
 <record id="template_tree" model="ir.ui.view"><field name="name">vehicle.inspection.template.tree</field><field name="model">distribution.vehicle.inspection.template</field><field name="arch" type="xml"><list><field name="name"/><field name="inspection_type"/><field name="daily_task"/><field name="active"/></list></field></record>
 <record id="template_form" model="ir.ui.view"><field name="name">vehicle.inspection.template.form</field><field name="model">distribution.vehicle.inspection.template</field><field name="arch" type="xml"><form><sheet><group col="2"><group><field name="name"/><field name="inspection_type"/><field name="company_id"/><field name="active"/></group><group><field name="daily_task"/><field name="required_before_start"/><field name="driver_ids" widget="many2many_tags"/></group></group><field name="line_ids"><list editable="bottom"><field name="sequence"/><field name="name"/><field name="response_type"/><field name="required"/><field name="critical"/><field name="requires_photo"/><field name="requires_note"/></list></field></sheet></form></field></record>
 <record id="template_action" model="ir.actions.act_window"><field name="name">Inspection Templates</field><field name="res_model">distribution.vehicle.inspection.template</field><field name="view_mode">list,form</field></record>
</odoo>
