<odoo>

    <!-- ============================================================ -->
    <!-- Security (spec #33/#34)                                       -->
    <!--                                                               -->
    <!-- * Route representatives may read fleet vehicles and their      -->
    <!--   assignments so the route form shows the vehicle data.        -->
    <!-- * A record rule keeps representatives to vehicles tied to      -->
    <!--   their own routes or their own assignments; route managers    -->
    <!--   (and distribution vehicle managers) see everything within    -->
    <!--   their companies.                                             -->
    <!-- * Multi-company: the plan/assignment models already carry      -->
    <!--   check_company + company rules; the route snapshot fields     -->
    <!--   use check_company=True.                                      -->
    <!-- ============================================================ -->
    <record id="rule_fleet_vehicle_route_user" model="ir.rule">
        <field name="name">Fleet Vehicle: distribution route user scope</field>
        <field name="model_id" ref="fleet.model_fleet_vehicle"/>
        <field name="groups" eval="[(4, ref('flousflow_distribution_route_base.group_distribution_route_user'))]"/>
        <field name="domain_force">['|', '|',
            ('distribution_route_ids.user_id', '=', user.id),
            ('distribution_employee_assignment_ids.employee_id.user_id', '=', user.id),
            ('distribution_employee_assignment_ids.employee_id', 'in', user.employee_ids.ids)]</field>
    </record>

    <record id="rule_fleet_vehicle_route_manager" model="ir.rule">
        <field name="name">Fleet Vehicle: distribution route manager full access</field>
        <field name="model_id" ref="fleet.model_fleet_vehicle"/>
        <field name="groups" eval="[(4, ref('flousflow_distribution_route_base.group_distribution_route_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
