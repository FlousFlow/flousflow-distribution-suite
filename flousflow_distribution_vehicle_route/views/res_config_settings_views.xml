<odoo>

    <!-- Settings: extend the Distribution Route app settings with the
         vehicle integration requirements (spec #10). -->
    <record id="res_config_settings_view_form_inherit_vehicle_route"
            model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.vehicle.route</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="flousflow_distribution_route_base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='distribution_area_setting_container']" position="after">
                <block title="Vehicle on Routes" name="distribution_vehicle_route_setting_container">
                    <setting id="require_vehicle_on_route_setting"
                             string="Require Vehicle on Route"
                             help="Route plans cannot be confirmed unless the employee has an active vehicle assignment">
                        <field name="distribution_require_vehicle_on_route"/>
                    </setting>
                    <setting id="require_vehicle_pos_on_route_setting"
                             string="Require Vehicle POS on Route"
                             help="Route vehicles must have a POS configuration before the route can be confirmed or started">
                        <field name="distribution_require_vehicle_pos_on_route"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
