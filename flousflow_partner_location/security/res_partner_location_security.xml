<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_flousflow_partner_location" model="ir.module.category">
        <field name="name">Customer Geo Location</field>
        <field name="sequence">60</field>
    </record>

    <record id="res_groups_privilege_customer_location" model="res.groups.privilege">
        <field name="name">Customer Location</field>
        <field name="category_id" ref="module_category_flousflow_partner_location"/>
    </record>

    <record id="group_location_manager" model="res.groups">
        <field name="name">Manage Customer Locations</field>
        <field name="privilege_id" ref="res_groups_privilege_customer_location"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Allows manually editing customer latitude/longitude coordinates.</field>
    </record>
</odoo>
