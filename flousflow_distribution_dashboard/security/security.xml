<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Privilege + group: the dashboard is visible to the distribution
         route manager and to anyone explicitly granted this group. -->
    <record model="res.groups.privilege"
            id="res_groups_privilege_distribution_dashboard">
        <field name="name">Distribution Dashboard</field>
        <field name="sequence">28</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="group_distribution_dashboard_user" model="res.groups">
        <field name="name">Dashboard Viewer</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_distribution_dashboard"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="comment">Read-only access to the distribution performance dashboard. Data is still filtered by the route/visit record rules of the underlying modules.</field>
    </record>

    <!-- Distribution route managers see the dashboard automatically.
         (The vehicle/GPS dashboard extensions grant the same to their
         own manager groups in their security files.) -->
    <record id="flousflow_distribution_route_base.group_distribution_route_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_distribution_dashboard_user'))]"/>
    </record>

</odoo>
